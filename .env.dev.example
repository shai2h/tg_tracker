DB_NAME=tg_tracker
DB_USER=login
DB_PASS=pass

# Values used inside Docker containers.
DB_HOST=db
DB_PORT=5432
API_BASE_URL=http://api:8000

# Host port for connecting to PostgreSQL
DB_HOST_PORT=5434

DB_ECHO=True

# Telegram token is used only by aiogram.
BOT_TOKEN=telegram_bot_token_for_aiogram

# Internal bot -> FastAPI token for Authorization: Bearer <BOT_API_TOKEN>.
BOT_API_TOKEN=internal_bot_to_api_secret
